DB_USERNAME=owlly
DB_PASSWORD=owlly
DB_HOST=localhost
DB_PORT=5432
DB_NAME=owlly

# 아래 값은 예시입니다. .env에서 실제 값으로 바꿔 주세요.
VERIFICATION_SECRET=
MAIL_FROM=발송용계정@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=발송용계정@gmail.com
SPRING_MAIL_PASSWORD=Gmail_앱_비밀번호

# 민감정보 암호화 키(AES-256, Base64 32바이트). 각자 생성해서 넣기: openssl rand -base64 32
OWLLY_CRYPTO_AES_KEY=

# 서버 세션: 30분은 개발 기본값이며 운영 만료 정책은 별도로 결정합니다.
SESSION_TIMEOUT=30m
# localhost HTTP 개발에서만 false. 운영 HTTPS에서는 반드시 true.
SESSION_COOKIE_SECURE=false
# 프론트엔드 및 직접 호출하는 서버의 Origin (쉼표 구분, 와일드카드 금지)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# 초기/로컬 DB는 always. 운영은 스키마를 배포한 후 never로 설정.
SESSION_SCHEMA_INIT=always
