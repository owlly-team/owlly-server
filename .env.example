DB_USERNAME=owlly
DB_PASSWORD=owlly
DB_HOST=localhost
DB_PORT=5432
DB_NAME=owlly

# 아래 값은 예시입니다. .env에서 실제 값으로 바꿔 주세요.
VERIFICATION_SECRET=
MAIL_FROM=발송용계정@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=발송용계정@gmail.com
SPRING_MAIL_PASSWORD=Gmail_앱_비밀번호

# 민감정보 암호화 키(AES-256, Base64 32바이트). 각자 생성해서 넣기: openssl rand -base64 32
OWLLY_CRYPTO_AES_KEY=

# 서버 세션: 30분은 개발 기본값이며 운영 만료 정책은 별도로 결정합니다.
SESSION_TIMEOUT=30m
# localhost HTTP 개발에서만 false. 운영 HTTPS에서는 반드시 true.
SESSION_COOKIE_SECURE=false
# 프론트엔드 및 직접 호출하는 서버의 Origin (쉼표 구분, 와일드카드 금지)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# 초기/로컬 DB는 always. 운영은 스키마를 배포한 후 never로 설정.
SESSION_SCHEMA_INIT=always

# 카카오 REST API 키(Owlly 앱). 택시 요금(카카오모빌리티 길찾기)과 하차 좌표 → 행정동 판별(카카오맵 로컬)에 사용. 값은 노션 Env 페이지 참고
KAKAO_REST_API_KEY=
# 경기도 버스(GBIS) 서비스 키. 막차 시간 조회용(연동 예정). 값은 노션 Env 페이지 참고
GBIS_SERVICE_KEY=

# 동승 출발 시간대(HH:MM, 한국 시간, 30분 단위). 기본은 화면정의서의 22:00~02:00이라 낮에는 동승 신청이 422(INVALID_DEPARTURE_SLOT)로 막힙니다.
# 낮에 시연·테스트할 때만 바꾸세요. 예) 14:00 ~ 17:00. 출발 15분 전까지만 등록할 수 있는 규칙은 그대로입니다.
# 심야할증(23:00~04:00)은 출발 시각 기준이라 낮 시간대에는 택시 요금에 할증이 붙지 않습니다.
OWLLY_MATCHING_SLOT_START=22:00
OWLLY_MATCHING_SLOT_END=02:00
